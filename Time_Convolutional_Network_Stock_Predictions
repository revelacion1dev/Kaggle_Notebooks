"execution_count":null},{"cell_type":"markdown","source":"# Time convolutional Network:\n\n    This notebooks is submited inside MITSUI&CO. Commodity Prediction Challenge context","metadata":{}},{"cell_type":"code","source":"import os\nimport gc\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport polars as pl\nfrom typing import Dict, List, Tuple, Optional\nimport time\n\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import Dataset, DataLoader\nimport torch.nn.functional as F\n\nimport optuna\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error\nfrom scipy.stats import spearmanr\n\nimport plotly.graph_objects as go\nimport plotly.subplots as sp\nfrom plotly.offline import plot\n\nimport kaggle_evaluation.mitsui_inference_server\n\nwarnings.filterwarnings('ignore')\n\nNUM_TARGET_COLUMNS = 424\nSEQUENCE_LENGTH = 50\nDEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n\nclass FinancialMetrics:\n    \"\"\"Simplified financial metrics\"\"\"\n    \n    @staticmethod\n    def directional_accuracy(y_true: np.ndarray, y_pred: np.ndarray) -> Dict[str, float]:\n        \"\"\"Directional accuracy - percentage of correct directions predicted\"\"\"\n        results = {}\n        \n        try:\n            for i in range(min(y_true.shape[1], y_pred.shape[1])):\n                if len(y_true) > 1:\n                    true_direction = np.sign(np.diff(y_true[:, i]))\n                    pred_direction = np.sign(np.diff(y_pred[:, i]))\n                    \n                    if len(true_direction) > 0:\n                        directional_acc = np.mean(true_direction == pred_direction)\n                        results[f'directional_acc_{i}'] = directional_acc\n            \n            if results:\n                results['mean_directional_accuracy'] = np.mean(list(results.values()))\n        except Exception as e:\n            print(f\"Warning in directional_accuracy: {e}\")\n            results['mean_directional_accuracy'] = 0.5\n        \n        return results\n\nclass TrainingLogger:\n    \"\"\"Simplified training logger\"\"\"\n    \n    def __init__(self):\n        self.reset()\n    \n    def reset(self):\n        self.train_losses = []\n        self.val_losses = []\n        self.correlations_history = []\n        self.financial_metrics_history = []\n        \n    def log_epoch(self, epoch, train_loss, correlations=None, financial_metrics=None):\n        self.train_losses.append(train_loss)\n        if correlations is not None:\n            self.correlations_history.append(correlations)\n        if financial_metrics is not None:\n            self.financial_metrics_history.append(financial_metrics)\n    \n    def plot_training_history(self):\n        \"\"\"Simple training plot\"\"\"\n        try:\n            fig = go.Figure()\n            \n            epochs = list(range(1, len(self.train_losses) + 1))\n            fig.add_trace(go.Scatter(\n                x=epochs,\n                y=self.train_losses,\n                mode='lines',\n                name='Training Loss',\n                line=dict(color='blue', width=2)\n            ))\n            \n            fig.update_layout(\n                title='Training Progress',\n                xaxis_title='Epoch',\n                yaxis_title='Loss',\n                template='plotly_white'\n            )\n            \n            plot(fig, filename='training_history.html', auto_open=False)\n            print(\"📊 Training history saved as 'training_history.html'\")\n            \n        except Exception as e:\n            print(f\"Warning: Could not create plot: {e}\")\n\nclass Chomp1d(nn.Module):\n    def __init__(self, chomp_size: int):\n        super().__init__()\n        self.chomp_size = chomp_size\n\n    def forward(self, x):\n        return x[:, :, :-self.chomp_size].contiguous() if self.chomp_size > 0 else x\n\nclass TemporalBlock(nn.Module):\n    def __init__(self, n_inputs: int, n_outputs: int, kernel_size: int, \n                 stride: int, dilation: int, padding: int, dropout: float = 0.2):\n        super().__init__()\n        \n        self.conv1 = nn.Conv1d(n_inputs, n_outputs, kernel_size,\n                              stride=stride, padding=padding, dilation=dilation)\n        self.chomp1 = Chomp1d(padding)\n        self.relu1 = nn.ReLU()\n        self.dropout1 = nn.Dropout(dropout)\n\n        self.conv2 = nn.Conv1d(n_outputs, n_outputs, kernel_size,\n                              stride=stride, padding=padding, dilation=dilation)\n        self.chomp2 = Chomp1d(padding)\n        self.relu2 = nn.ReLU()\n        self.dropout2 = nn.Dropout(dropout)\n\n        self.net = nn.Sequential(self.conv1, self.chomp1, self.relu1, self.dropout1,\n                                self.conv2, self.chomp2, self.relu2, self.dropout2)\n        \n        self.downsample = nn.Conv1d(n_inputs, n_outputs, 1) if n_inputs != n_outputs else None\n        self.relu = nn.ReLU()\n\n    def forward(self, x):\n        out = self.net(x)\n        res = x if self.downsample is None else self.downsample(x)\n        return self.relu(out + res)\n\nclass TemporalConvNet(nn.Module):\n    def __init__(self, num_inputs: int, num_channels: List[int], \n                 kernel_size: int = 2, dropout: float = 0.2):\n        super().__init__()\n        layers = []\n        num_levels = len(num_channels)\n        \n        for i in range(num_levels):\n            dilation_size = 2 ** i\n            in_channels = num_inputs if i == 0 else num_channels[i-1]\n            out_channels = num_channels[i]\n            \n            layers += [TemporalBlock(in_channels, out_channels, kernel_size, \n                                   stride=1, dilation=dilation_size,\n                                   padding=(kernel_size-1) * dilation_size, \n                                   dropout=dropout)]\n\n        self.network = nn.Sequential(*layers)\n\n    def forward(self, x):\n        return self.network(x)\n\nclass MitsuiTCNModel(nn.Module):\n    def __init__(self, input_dim: int, tcn_channels: List[int], \n                 num_targets: int = NUM_TARGET_COLUMNS, \n                 kernel_size: int = 3, dropout: float = 0.2):\n        super().__init__()\n        \n        self.input_dim = input_dim\n        self.tcn = TemporalConvNet(input_dim, tcn_channels, kernel_size, dropout)\n        \n        # Simplified output layers\n        self.output_layer = nn.Sequential(\n            nn.Linear(tcn_channels[-1], 128),\n            nn.ReLU(),\n            nn.Dropout(dropout),\n            nn.Linear(128, num_targets)\n        )\n        \n    def forward(self, x):\n        x = x.transpose(1, 2)  # [batch, features, seq_len]\n        tcn_out = self.tcn(x)\n        tcn_out = tcn_out[:, :, -1]  # Take last timestep\n        \n        output = self.output_layer(tcn_out)\n        return output\n\nclass CommodityDataset(Dataset):\n    def __init__(self, features: np.ndarray, targets: np.ndarray, \n                 sequence_length: int = SEQUENCE_LENGTH):\n        self.sequence_length = sequence_length\n        self.features = features\n        self.targets = targets\n        \n    def __len__(self):\n        return max(0, len(self.features) - self.sequence_length + 1)\n    \n    def __getitem__(self, idx):\n        x = self.features[idx:idx + self.sequence_length]\n        y = self.targets[idx + self.sequence_length - 1]\n        \n        return torch.FloatTensor(x), torch.FloatTensor(y)\n\nclass MitsuiCommodityPredictor:\n    def __init__(self, sequence_length: int = SEQUENCE_LENGTH):\n        self.sequence_length = sequence_length\n        self.model = None\n        self.scaler_features = StandardScaler()\n        self.scaler_targets = StandardScaler()\n        self.best_params = None\n        self.target_columns = None\n        self.logger = TrainingLogger()\n        # Store exact feature configuration from training\n        self.train_feature_columns = None  # Exact columns used in training\n        self.train_feature_count = None    # Total number of features expected\n        self.num_rolling_features = 0\n        \n    def load_and_inspect_data(self, base_path: str):\n        \"\"\"Load and inspect data with error handling\"\"\"\n        print(\"🔍 Loading MITSUI data...\")\n        \n        try:\n            train_path = os.path.join(base_path, 'train.csv')\n            labels_path = os.path.join(base_path, 'train_labels.csv')\n            \n            if os.path.exists(train_path) and os.path.exists(labels_path):\n                print(f\"📂 Loading train.csv...\")\n                train_data = pl.read_csv(train_path)\n                print(f\"   Shape: {train_data.shape}\")\n                \n                print(f\"📂 Loading train_labels.csv...\")\n                train_labels = pl.read_csv(labels_path)\n                print(f\"   Shape: {train_labels.shape}\")\n                \n                # Find target columns\n                target_columns = [col for col in train_labels.columns if 'target' in col.lower()]\n                print(f\"🎯 Found {len(target_columns)} target columns\")\n                \n                # Combine datasets\n                if 'date_id' in train_data.columns and 'date_id' in train_labels.columns:\n                    combined_data = train_data.join(train_labels, on='date_id', how='inner')\n                else:\n                    # Simple concatenation if no date_id\n                    train_pd = train_data.to_pandas()\n                    labels_pd = train_labels.to_pandas()\n                    combined_pd = pd.concat([train_pd, labels_pd], axis=1)\n                    combined_data = pl.from_pandas(combined_pd)\n                \n                print(f\"✅ Combined dataset: {combined_data.shape}\")\n                return combined_data, target_columns\n                \n        except Exception as e:\n            print(f\"❌ Error loading data: {e}\")\n            \n        return None, []\n    \n    def create_features(self, df: pl.DataFrame, is_training: bool = True) -> np.ndarray:\n        \"\"\"Feature engineering with perfect consistency between train and test\"\"\"\n        print(\"🛠️ Creating features...\")\n        \n        try:\n            df_pd = df.to_pandas()\n            \n            # Get numeric columns only\n            numeric_cols = df_pd.select_dtypes(include=[np.number]).columns.tolist()\n            if 'date_id' in numeric_cols:\n                numeric_cols.remove('date_id')\n            \n            # Remove target columns from features\n            feature_cols = [col for col in numeric_cols if not col.startswith('target_')]\n            \n            if is_training:\n                # Store the exact columns used during training\n                self.train_feature_columns = feature_cols\n                print(f\"   Training mode: {len(feature_cols)} feature columns\")\n                \n                # Use all available columns for base features\n                features = df_pd[feature_cols].copy()\n                \n            else:\n                # During inference, align with training columns\n                print(f\"   Inference mode: {len(feature_cols)} available columns\")\n                \n                # Create dataframe with the exact training columns\n                features = pd.DataFrame(index=df_pd.index)\n                \n                # Add columns that exist in both train and test\n                for col in self.train_feature_columns:\n                    if col in df_pd.columns:\n                        features[col] = df_pd[col]\n                    else:\n                        # Add dummy column for missing features\n                        features[col] = 0\n                        \n                print(f\"   Aligned to {len(self.train_feature_columns)} training columns\")\n            \n            # Simple preprocessing\n            features = features.fillna(method='ffill').fillna(method='bfill').fillna(0)\n            \n            # Add rolling features\n            if is_training and len(features) > 10:\n                print(\"   Adding rolling features...\")\n                rolling_features = []\n                \n                # Use first 50 columns for rolling features\n                for col in feature_cols[:50]:\n                    try:\n                        ma5 = features[col].rolling(5, min_periods=1).mean()\n                        rolling_features.append(ma5)\n                    except:\n                        continue\n                \n                if rolling_features:\n                    self.num_rolling_features = len(rolling_features)\n                    rolling_df = pd.concat(rolling_features, axis=1)\n                    rolling_df.columns = [f'ma5_{i}' for i in range(len(rolling_df.columns))]\n                    features = pd.concat([features, rolling_df], axis=1)\n                    \n                # Store the total feature count for validation\n                self.train_feature_count = features.shape[1]\n                    \n            elif not is_training:\n                # During inference, add rolling features (even if dummy)\n                if self.num_rolling_features > 0:\n                    print(f\"   Adding {self.num_rolling_features} rolling features...\")\n                    rolling_features = []\n                    \n                    # Try to compute rolling features from aligned columns\n                    for i, col in enumerate(self.train_feature_columns[:50]):\n                        if i >= self.num_rolling_features:\n                            break\n                        try:\n                            ma5 = features[col].rolling(5, min_periods=1).mean()\n                            rolling_features.append(ma5)\n                        except:\n                            # Add dummy if computation fails\n                            rolling_features.append(pd.Series([0] * len(features)))\n                    \n                    if len(rolling_features) < self.num_rolling_features:\n                        # Pad with zeros if needed\n                        for _ in range(self.num_rolling_features - len(rolling_features)):\n                            rolling_features.append(pd.Series([0] * len(features)))\n                    \n                    rolling_df = pd.concat(rolling_features, axis=1)\n                    rolling_df.columns = [f'ma5_{i}' for i in range(self.num_rolling_features)]\n                    features = pd.concat([features, rolling_df], axis=1)\n                \n                # Ensure we have exactly the right number of features\n                if features.shape[1] != self.train_feature_count:\n                    print(f\"   ⚠️ Feature mismatch: {features.shape[1]} vs expected {self.train_feature_count}\")\n                    # Pad or trim as needed\n                    if features.shape[1] < self.train_feature_count:\n                        # Add dummy columns\n                        for i in range(self.train_feature_count - features.shape[1]):\n                            features[f'dummy_{i}'] = 0\n                    else:\n                        # Trim extra columns\n                        features = features.iloc[:, :self.train_feature_count]\n            \n            # Final cleanup\n            features = features.fillna(0)\n            features = features.replace([np.inf, -np.inf], 0)\n            \n            print(f\"   Final features shape: {features.shape}\")\n            return features.values\n            \n        except Exception as e:\n            print(f\"   ❌ Error in feature creation: {e}\")\n            import traceback\n            traceback.print_exc()\n            # Return fallback with correct dimensions\n            if not is_training and self.train_feature_count:\n                return np.zeros((1, self.train_feature_count))\n            else:\n                df_pd = df.to_pandas()\n                numeric_cols = df_pd.select_dtypes(include=[np.number]).columns\n                feature_cols = [col for col in numeric_cols if not col.startswith('target_') and col != 'date_id']\n                return df_pd[feature_cols[:100]].fillna(0).values\n    \n    def calculate_stability_score(self, y_true: np.ndarray, y_pred: np.ndarray) -> float:\n        \"\"\"Calculate stability score based on correlation\"\"\"\n        try:\n            correlations = []\n            \n            for i in range(min(y_true.shape[1], y_pred.shape[1], 50)):\n                try:\n                    if len(np.unique(y_true[:, i])) > 1 and len(np.unique(y_pred[:, i])) > 1:\n                        corr, _ = spearmanr(y_true[:, i], y_pred[:, i])\n                        if not np.isnan(corr):\n                            correlations.append(corr)\n                except:\n                    continue\n                    \n            if len(correlations) == 0:\n                return 0.0\n                \n            mean_corr = np.mean(correlations)\n            std_corr = np.std(correlations)\n            stability_score = mean_corr / (std_corr + 1e-8)\n            \n            return float(stability_score)\n            \n        except Exception as e:\n            print(f\"Warning in stability calculation: {e}\")\n            return 0.0\n    \n    def optimize_hyperparameters(self, train_features: np.ndarray, \n                                train_targets: np.ndarray, n_trials: int = 10) -> Dict:\n        \"\"\"Simplified hyperparameter optimization\"\"\"\n        \n        print(f\"🎯 Starting optimization with {n_trials} trials\")\n        \n        def objective(trial):\n            try:\n                params = {\n                    'tcn_channels': [\n                        trial.suggest_int('channel_1', 16, 64, step=16),\n                        trial.suggest_int('channel_2', 32, 128, step=16), \n                        trial.suggest_int('channel_3', 16, 64, step=16)\n                    ],\n                    'kernel_size': trial.suggest_int('kernel_size', 2, 4),\n                    'dropout': trial.suggest_float('dropout', 0.1, 0.3),\n                    'learning_rate': trial.suggest_float('learning_rate', 1e-4, 1e-2, log=True),\n                    'batch_size': trial.suggest_categorical('batch_size', [8, 16]),\n                    'epochs': trial.suggest_int('epochs', 5, 15)\n                    #'SEQUENCE_LENGTH' : trial.suggest_int('SEQUENCE_LENGHT',30,80)\n                }\n                \n                print(f\"🧪 Trial {trial.number + 1}: {params['tcn_channels']}\")\n                \n                # Simple train/validation split\n                split_idx = int(len(train_features) * 0.8)\n                \n                X_train_fold = train_features[:split_idx]\n                X_val_fold = train_features[split_idx:]\n                y_train_fold = train_targets[:split_idx]\n                y_val_fold = train_targets[split_idx:]\n                \n                score = self._train_and_evaluate(\n                    X_train_fold, y_train_fold, X_val_fold, y_val_fold, params\n                )\n                \n                print(f\"   Score: {score:.4f}\")\n                return score\n                \n            except Exception as e:\n                print(f\"   ❌ Trial failed: {e}\")\n                return -999.0\n        \n        study = optuna.create_study(direction='maximize')\n        study.optimize(objective, n_trials=n_trials, timeout=1800)\n        \n        self.best_params = study.best_params\n        print(f\"🏆 Best score: {study.best_value:.4f}\")\n        print(f\"🏅 Best params: {self.best_params}\")\n        \n        return self.best_params\n    \n    def _train_and_evaluate(self, X_train: np.ndarray, y_train: np.ndarray,\n                           X_val: np.ndarray, y_val: np.ndarray, params: Dict) -> float:\n        \"\"\"Training and evaluation\"\"\"\n        \n        try:\n            # Check data availability\n            if len(X_train) < self.sequence_length or len(X_val) < self.sequence_length:\n                return -999.0\n            \n            # Create datasets\n            train_dataset = CommodityDataset(X_train, y_train, self.sequence_length)\n            val_dataset = CommodityDataset(X_val, y_val, self.sequence_length)\n            \n            if len(train_dataset) == 0 or len(val_dataset) == 0:\n                return -999.0\n            \n            train_loader = DataLoader(train_dataset, batch_size=params['batch_size'], \n                                     shufflepoche=True, drop_last=True)\n            val_loader = DataLoader(val_dataset, batch_size=params['batch_size'], \n                                   shuffle=False, drop_last=True)\n            \n            # Create model\n            input_dim = X_train.shape[1]\n            num_targets = y_train.shape[1]\n            \n            model = MitsuiTCNModel(\n                input_dim=input_dim,\n                tcn_channels=params['tcn_channels'],\n                kernel_size=params['kernel_size'],\n                dropout=params['dropout'],\n                num_targets=num_targets\n            ).to(DEVICE)\n            \n            optimizer = optim.Adam(model.parameters(), lr=params['learning_rate'])\n            criterion = nn.MSELoss()\n            \n            # Training\n            model.train()\n            for epoch in range(params['epochs']):\n                for batch_x, batch_y in train_loader:\n                    batch_x, batch_y = batch_x.to(DEVICE), batch_y.to(DEVICE)\n                    \n                    optimizer.zero_grad()\n                    outputs = model(batch_x)\n                    loss = criterion(outputs, batch_y)\n                    loss.backward()\n                    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n                    optimizer.step()\n            \n            # Evaluation\n            model.eval()\n            all_predictions = []\n            all_targets = []\n            \n            with torch.no_grad():\n                for batch_x, batch_y in val_loader:\n                    batch_x = batch_x.to(DEVICE)\n                    outputs = model(batch_x)\n                    \n                    all_predictions.append(outputs.cpu().numpy())\n                    all_targets.append(batch_y.numpy())\n            \n            if len(all_predictions) == 0:\n                return -999.0\n                \n            predictions = np.vstack(all_predictions)\n            targets = np.vstack(all_targets)\n            \n            # Calculate stability score\n            stability_score = self.calculate_stability_score(targets, predictions)\n            \n            # Cleanup\n            del model, optimizer\n            torch.cuda.empty_cache() if torch.cuda.is_available() else None\n            gc.collect()\n            \n            return stability_score\n            \n        except Exception as e:\n            print(f\"Training error: {e}\")\n            return -999.0\n    \n    def fit(self, train_data: pl.DataFrame, target_columns: List[str], \n            optimize_params: bool = True, n_trials: int = 10):\n        \"\"\"Training with perfect feature tracking\"\"\"\n        \n        print(f\"🚀 Starting training with {len(target_columns)} targets\")\n        print(f\"📊 Data shape: {train_data.shape}\")\n        \n        self.logger.reset()\n        \n        # Create features for training\n        features = self.create_features(train_data, is_training=True)\n        \n        # Verify feature count was stored\n        if self.train_feature_count is None:\n            self.train_feature_count = features.shape[1]\n            print(f\"   Stored feature count: {self.train_feature_count}\")\n        \n        # Get targets\n        available_targets = [col for col in target_columns if col in train_data.columns]\n        targets = train_data.select(available_targets).to_pandas().values\n        self.target_columns = available_targets\n        \n        print(f\"✅ Features: {features.shape}\")\n        print(f\"✅ Targets: {len(available_targets)}\")\n        \n        # Clean data\n        features = np.nan_to_num(features, nan=0.0, posinf=0.0, neginf=0.0)\n        targets = np.nan_to_num(targets, nan=0.0, posinf=0.0, neginf=0.0)\n        \n        # Scale - IMPORTANT: fit the scaler with the exact feature count\n        features_scaled = self.scaler_features.fit_transform(features)\n        targets_scaled = self.scaler_targets.fit_transform(targets)\n        \n        print(f\"   Scaler fitted with {features_scaled.shape[1]} features\")\n        \n        # Optimize if needed\n        if optimize_params and len(features) > 100:\n            self.optimize_hyperparameters(features_scaled, targets_scaled, n_trials)\n        \n        # Set default params if not optimized\n        if self.best_params is None:\n            self.best_params = {\n                'tcn_channels': [32, 64, 32],\n                'kernel_size': 3,\n                'dropout': 0.2,\n                'learning_rate': 0.001,\n                'batch_size': 16,\n                'epochs': 20\n            }\n        \n        # Convert to expected format\n        if 'channel_1' in self.best_params:\n            self.best_params['tcn_channels'] = [\n                self.best_params['channel_1'],\n                self.best_params['channel_2'],\n                self.best_params['channel_3']\n            ]\n        \n        print(f\"🏋️ Final training...\")\n        print(f\"   Channels: {self.best_params['tcn_channels']}\")\n        print(f\"   Learning rate: {self.best_params['learning_rate']}\")\n        \n        # Create final dataset\n        dataset = CommodityDataset(features_scaled, targets_scaled, self.sequence_length)\n        \n        i